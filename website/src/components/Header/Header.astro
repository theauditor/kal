---
import KaalLogo from '@branding/KaalLogo.astro';
import Search from './Search';
import CommandLineIcon from '@heroicons/react/20/solid/CommandLineIcon';
import MobileNav from '../../docs/MobileNav';
import { SIDEBAR } from '../../config';
import { WindowControls } from '../../repl/components/panel/WindowControls';

type Props = {
  currentPage?: string;
};

const { currentPage } = Astro.props as Props;
// const lang = getLanguageFromURL(currentPage);
const langCode = 'en'; // getLanguageFromURL(currentPage);
const sidebar = SIDEBAR[langCode];

const { BASE_URL } = import.meta.env;
const baseNoTrailing = BASE_URL.endsWith('/') ? BASE_URL.slice(0, -1) : BASE_URL;
---

<nav
  class="flex justify-between py-2 px-margin-desktop items-center h-16 bg-surface-container-low/60 backdrop-blur-xl border-b border-outline-variant text-on-background"
  title="Top Navigation"
  style="font-family: Sora, sans-serif;"
  data-tauri-drag-region
>
  <div class="flex overflow-visible items-center grow" style="overflow:visible">
    <div class="flex items-center text-2xl space-x-2">
      <a href={`${baseNoTrailing}/`} class="flex items-center gap-3 hover:opacity-90 transition-opacity">
        <KaalLogo size={40} />
        <div class="flex flex-col leading-none">
          <span class="font-display-lg text-xl uppercase tracking-[0.2em] font-bold">KĀL</span>
          <span class="text-[10px] text-on-surface-variant tracking-[0.3em] font-medium opacity-70">LIVE PERFORMANCE STATION</span>
        </div>
      </a>
    </div>
  </div>
  {/* KNOWN_LANGUAGE_CODES.length > 1 && <LanguageSelect lang={lang} client:idle /> */}
  <div class="search-item h-10">
    <Search client:idle />
  </div>
  <a href={`${baseNoTrailing}/p/`} class="hidden md:flex cursor-pointer items-center gap-2 font-label-uppercase text-label-uppercase text-[#c9a84c] hover:opacity-80 transition-opacity"
    ><CommandLineIcon className="w-5 h-5" /><span>GO TO STATION</span>
  </a>
  <div class="md:hidden">
    <MobileNav sidebar={sidebar} client:idle />
  </div>
  <WindowControls client:load />
</nav>

<style>
  /** Style Algolia */
  :root {
    --docsearch-primary-color: var(--lineHighlight);
    --docsearch-logo-color: var(--foreground);
  }

  .search-item {
    display: none;
    position: relative;
    z-index: 10;
    flex-grow: 1;
    padding-right: 0.7rem;
    display: flex;
    max-width: 200px;
  }

  @media (min-width: 50em) {
    .search-item {
      max-width: 400px;
    }
  }
</style>

<style is:global>
  .search-item > * {
    flex-grow: 1;
  }
</style>
<script>
  const nav = document.querySelector('nav[data-tauri-drag-region]');
  if (nav && window.__TAURI_INTERNALS__) {
    nav.addEventListener('mousedown', (e) => {
      // @ts-ignore
      if (e.button === 0 && !e.target.closest('button, input, a, select, [role="button"]')) {
        // @ts-ignore
        window.__TAURI_INTERNALS__.invoke('plugin:window|start_dragging');
      }
    });
  }
</script>
