{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "jsxImportSource": "react",
    "noImplicitAny": false,
    "baseUrl": ".",
    "paths": {
      "@components/*": ["src/components/*"],
      "@branding/*": ["src/components/branding/*"],
      "@assets/*": ["src/assets/*"],
      "@src/*": ["src/*"],
    }
  }
}